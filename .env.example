# Copy to .env. Dev-only values; never commit real secrets.
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction_dev_password
POSTGRES_DB=auction
DATABASE_URL=postgres://auction:auction_dev_password@postgres:5432/auction

REDIS_URL=redis://redis:6379

MEILI_MASTER_KEY=dev_meili_master_key_change_me_32chars
MEILI_URL=http://meilisearch:7700

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_dev_access
S3_SECRET_KEY=minio_dev_secret_key
S3_BUCKET=lots
S3_REGION=us-east-1

SMTP_HOST=mail
SMTP_PORT=1025
MAIL_FROM=auction@example.test

JWT_SECRET=dev_jwt_secret_change_me_at_least_32_chars
PAYMENT_WEBHOOK_SECRET=dev_webhook_hmac_secret_change_me
# none | chaos  (chaos: duplicate, delayed up to 1 min, out-of-order, or dropped webhooks)
PAYMENT_STUB_MODE=none
PAYMENT_STUB_BASE_URL=http://localhost:8080

PUBLIC_API_URL=http://localhost:8080
SEED_ON_START=true
