{
  "name": "@auction/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@auction/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-presigned-post": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/websockets": "^12.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "meilisearch": "^0.63.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}
