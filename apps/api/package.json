{
  "name": "@auction/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@auction/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-presigned-post": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
